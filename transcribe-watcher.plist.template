<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.transcribe-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/transcribe-env/bin/python</string>
        <string>__HOME__/transcribe/watch_and_transcribe.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/transcribe-watcher.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/transcribe-watcher.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>
</dict>
</plist>
